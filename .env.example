# PostgreSQL connection string used by the OLV application and health check.
DATABASE_URL=postgresql://rolefield:password@localhost:5432/rolefield

# AWS DynamoDB tables used for durable website conversion data.
WEBSITE_SUBSCRIBER_TABLE=rolefield-website-data-subscribers
WEBSITE_DEMO_BOOKING_TABLE=rolefield-website-data-demo-bookings

# Amazon SES transactional email configuration. Storage succeeds before delivery is attempted.
WEBSITE_SENDER_EMAIL=hello@rolefield.ai
LEAD_NOTIFICATION_EMAIL=arbaz@ai7lab.net
SUBSCRIBER_NOTIFICATION_EMAIL=arbaz@ai7lab.net
REPLY_TO_EMAIL=arbaz@ai7lab.net
WEBSITE_SES_CONFIGURATION_SET=

# Public canonical URL used in transactional email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OLV runtime and secure sessions.
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
REDIS_URL=redis://localhost:6379
OLV_SESSION_SECRET=replace-with-32-or-more-random-characters
PASSWORD_PEPPER=replace-with-a-separate-random-secret
ENCRYPTION_KEY=replace-with-32-or-more-random-characters
SESSION_TTL_HOURS=12
ACTIVATION_TOKEN_TTL_MINUTES=60
RESET_TOKEN_TTL_MINUTES=30
MAX_ATTACHMENT_BYTES=25000000
MAX_MESSAGE_BYTES=40000000

# AWS uses the standard SDK credential chain. Prefer an IAM role in production.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SES_REGION=us-east-1
SES_CONFIGURATION_SET=olv-events
INVITATION_FROM_EMAIL=invite@example.com
S3_REGION=us-east-1
S3_BUCKET=private-olv-mail
S3_KMS_KEY_ID=

# High-entropy shared secrets for authenticated AWS event bridges.
INBOUND_WEBHOOK_SECRET=replace-with-32-or-more-random-characters
SES_EVENT_WEBHOOK_SECRET=replace-with-32-or-more-random-characters
WORKER_CONCURRENCY=5

# Meeting provider stack. Leave an entire provider group blank to expose an
# explicit NotConfigured state; partial groups fail validation.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Amazon Transcribe Streaming uses the standard AWS credential chain.
TRANSCRIBE_REGION=ap-south-1

# Frozen Google Gemini model hierarchy and multimodal embedding contract.
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_STANDARD_MODEL=gemini-3.7-flash
GEMINI_COMPLEX_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=1536

# Google Calendar API v3 OAuth and push notification channel.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://example.com/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://example.com/api/webhooks/google-calendar
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Private meeting objects (SSE-KMS) and authorization-bound CloudFront delivery.
MEETING_S3_REGION=ap-south-1
MEETING_S3_BUCKET=
MEETING_S3_KMS_KEY_ID=
MEETING_CLOUDFRONT_DOMAIN=
MEETING_CLOUDFRONT_KEY_PAIR_ID=
MEETING_CLOUDFRONT_PRIVATE_KEY=

# TLS-only ElastiCache Valkey endpoint; never use as the durable record.
VALKEY_URL=

# Dedicated queues. Each queue must be provisioned with its own DLQ.
MEETING_SQS_REGION=ap-south-1
SQS_DOCUMENT_PROCESSING_URL=
SQS_SCREENSHOT_INTELLIGENCE_URL=
SQS_MEETING_POSTPROCESSING_URL=
SQS_NOTIFICATION_DELIVERY_URL=
SQS_CALENDAR_SYNC_URL=
SQS_KNOWLEDGE_PROCESSING_URL=
SQS_TRAINING_PROCESSING_URL=

# Domain events only; durable work belongs on SQS.
EVENTBRIDGE_REGION=ap-south-1
EVENTBRIDGE_BUS_NAME=
EVENTBRIDGE_SOURCE=ai.rolefield.meetings
