# PostgreSQL connection string used by lead capture and the health check.
DATABASE_URL=postgresql://rolefield:password@localhost:5432/rolefield

# Brevo transactional email configuration. Keep the API key server-side.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@mail.rolefield.ai
BREVO_SENDER_NAME=RoleField
BREVO_DEMO_CUSTOMER_TEMPLATE_ID=1
BREVO_CALLBACK_CUSTOMER_TEMPLATE_ID=2
BREVO_DEMO_TEAM_TEMPLATE_ID=3
BREVO_CALLBACK_TEAM_TEMPLATE_ID=4
LEAD_NOTIFICATION_EMAIL=voice@ai7lab.net
REPLY_TO_EMAIL=voice@ai7lab.net

# Public canonical URL used in transactional email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
