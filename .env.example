# PostgreSQL connection string used by lead capture and the health check.
DATABASE_URL=postgresql://rolefield:password@localhost:5432/rolefield

# Brevo transactional email configuration. Keep the API key server-side.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@mail.rolefield.ai
BREVO_SENDER_NAME=RoleField
BREVO_DEMO_CUSTOMER_TEMPLATE_ID=1
BREVO_CALLBACK_CUSTOMER_TEMPLATE_ID=2
BREVO_DEMO_TEAM_TEMPLATE_ID=3
BREVO_CALLBACK_TEAM_TEMPLATE_ID=4
LEAD_NOTIFICATION_EMAIL=voice@ai7lab.net
REPLY_TO_EMAIL=voice@ai7lab.net

# Public canonical URL used in transactional email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OLV runtime and secure sessions.
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
REDIS_URL=redis://localhost:6379
OLV_SESSION_SECRET=replace-with-32-or-more-random-characters
PASSWORD_PEPPER=replace-with-a-separate-random-secret
ENCRYPTION_KEY=replace-with-32-or-more-random-characters
SESSION_TTL_HOURS=12
ACTIVATION_TOKEN_TTL_MINUTES=60
RESET_TOKEN_TTL_MINUTES=30
MAX_ATTACHMENT_BYTES=25000000
MAX_MESSAGE_BYTES=40000000

# AWS uses the standard SDK credential chain. Prefer an IAM role in production.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SES_REGION=us-east-1
SES_CONFIGURATION_SET=olv-events
INVITATION_FROM_EMAIL=invite@example.com
S3_REGION=us-east-1
S3_BUCKET=private-olv-mail

# High-entropy shared secrets for authenticated AWS event bridges.
INBOUND_WEBHOOK_SECRET=replace-with-32-or-more-random-characters
SES_EVENT_WEBHOOK_SECRET=replace-with-32-or-more-random-characters
WORKER_CONCURRENCY=5
