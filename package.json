{
  "name": "rolefield-gcc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run config:validate && npm run db:migrate && npm run db:owner && node scripts/start-production.mjs",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "worker": "tsx worker/index.ts",
    "config:validate": "node scripts/validate-env.mjs",
    "db:seed-local": "node scripts/seed-local.mjs",
    "db:owner": "node --env-file-if-exists=.env.local scripts/bootstrap-owner.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@aws-sdk/client-sqs": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.2.0",
    "imapflow": "^1.7.2",
    "ioredis": "^6.0.0",
    "next": "^16.2.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "postal-mime": "^3.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
